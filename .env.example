# ==========================================
# SkillProof Environment Configuration
# ==========================================

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
# Host port mapping for Docker container (defaults to 3307 to avoid conflict with existing local MySQL on 3306)
MYSQL_PORT=3307
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/skillproof_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# SMTP Mail Delivery Configuration
# For local development with Mailpit/MailHog:
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# For Production SMTP (e.g., SendGrid, AWS SES, Gmail):
# SPRING_MAIL_HOST=smtp.sendgrid.net
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=apikey
# SPRING_MAIL_PASSWORD=your_api_key_here
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# File Storage Upload Directory
APP_STORAGE_UPLOAD_DIR=./uploads
